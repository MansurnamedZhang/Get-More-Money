# Public DNS name pointing to this server.
APP_DOMAIN=invest.example.com

# Host ports used by Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# Generate independent values with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-with-a-random-64-character-hex-value
SANYU_CREDENTIAL_MASTER_KEY=replace-with-another-random-64-character-hex-value

RUST_LOG=info,tower_http=info
