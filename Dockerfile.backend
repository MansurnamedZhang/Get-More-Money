# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS builder
WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY backend ./backend
COPY services ./services

RUN cargo build --release --locked --workspace

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --home-dir /home/sanyu --shell /usr/sbin/nologin sanyu \
    && mkdir -p /data \
    && chown -R sanyu:sanyu /data

WORKDIR /app
USER sanyu

ENV RUST_LOG=info,tower_http=info

FROM runtime AS identity-service
COPY --from=builder /workspace/target/release/identity-service /usr/local/bin/identity-service
EXPOSE 3101
ENTRYPOINT ["identity-service"]

FROM runtime AS investment-core
COPY --from=builder /workspace/target/release/personal-investment-backend /usr/local/bin/personal-investment-backend
EXPOSE 3100
ENTRYPOINT ["personal-investment-backend"]

FROM runtime AS api-gateway
COPY --from=builder /workspace/target/release/api-gateway /usr/local/bin/api-gateway
EXPOSE 3001
ENTRYPOINT ["api-gateway"]
